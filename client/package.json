{
  "name": "matic-desk-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Matic Desk IT support assistant - demo build",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "start:elevated": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-elevated.ps1",
    "test": "node test/run-all.mjs",
    "probe": "node test/probe.test.mjs",
    "count-tokens": "node eval/count-tokens.mjs",
    "verify-cache": "node eval/verify-cache.mjs",
    "fetch-voice": "node scripts/fetch-voice.mjs",
    "inject-fault": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/inject-fault.ps1",
    "reset-demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-demo.ps1",
    "verify:privileged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-privileged.ps1",
    "test:cloud": "node test/cloud.test.mjs",
    "preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preflight.ps1",
    "check:adapter": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-adapter-visibility.ps1",
    "show-consent": "node scripts/show-consent.mjs",
    "verify:pipe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-pipe-security.ps1",
    "e2e:ask": "node eval/e2e-ask.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "koffi": "^3.2.0"
  },
  "devDependencies": {
    "electron": "^44.1.1"
  }
}

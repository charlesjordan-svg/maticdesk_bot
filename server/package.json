{
  "name": "matic-desk-hub",
  "version": "0.0.1",
  "private": true,
  "description": "Matic Desk hub - B0 walking skeleton (one route, one provider, no authentication, loopback only) plus the B1 control-plane schema and migration path.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/turn.test.mjs && node test/db-static.test.mjs",
    "test:db": "node test/db.test.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "migrate": "node bin/db.mjs migrate",
    "db": "node bin/db.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {}
}
